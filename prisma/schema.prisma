// Quorum — agentic tender review for public procurement.
// User/Session back the authentication screens (#/register, #/login);
// ContactMessage stores pilot requests from the landing page.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}

// ── Authentication ──────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String // scrypt:salt:hash
  organization String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Committee (the humans who hold the gavel) ───────────────────────────────
// The standing committee is stored data, not hardcoded copy: members are
// rows, seat capacity and the quorum threshold are settings, and the gavel
// seat belongs to whoever is actually signed in (resolved from the session).

model CommitteeMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  isChair   Boolean  @default(false)
  status    String   @default("PRESENT") // PRESENT | EXCUSED — a member; vacancy is the absence of a row
  seatOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
