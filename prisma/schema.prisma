// Quorum — agentic tender review for public procurement.
// User/Session back the authentication screens (#/register, #/login);
// ContactMessage stores pilot requests from the landing page.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}

// ── Authentication ──────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String // scrypt:salt:hash
  organization String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Committee (the humans who hold the gavel) ───────────────────────────────
// The standing committee is stored data, not hardcoded copy: members are
// rows, seat capacity and the quorum threshold are settings, and the gavel
// seat belongs to whoever is actually signed in (resolved from the session).

model CommitteeMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  isChair   Boolean  @default(false)
  status    String   @default("PRESENT") // PRESENT | EXCUSED — a member; vacancy is the absence of a row
  seatOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Workspace access (inviting teammates) ─────────────────────────────────
// One flat workspace: everyone with an account and a claimed seat reads the
// same runs, gates and audit trail. Invites are code-based (no email provider
// is configured), so an officer generates a code here and the invitee
// pastes it during registration.

model WorkspaceInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  email     String?  // optional note of who the code was meant for
  role      String   @default("OFFICER") // OFFICER | COMMITTEE — access level
  createdBy String
  inviterName  String
  claimedBy String? // the user id of whoever accepted
  claimedByEmail String?
  status    String   @default("PENDING") // PENDING | CLAIMED | REVOKED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claimedAt DateTime?
}
