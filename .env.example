# Copy to .env.local and fill in as needed. Nothing here is required to run:
# without LLM_BASE_URL + LLM_MODEL, redline drafting uses the deterministic
# template fallback and every run still completes.

# OpenAI-compatible chat endpoint for redline drafting, e.g. a self-hosted
# vLLM or Ollama instance serving an open-weights model.
LLM_BASE_URL=
LLM_MODEL=

# Only if the LLM endpoint requires a bearer key.
LLM_API_KEY=

# Where the MCP sidecar reaches the Next.js app (default: http://127.0.0.1:3000).
QUORUM_WEB_URL=http://127.0.0.1:3000
